# Browser-safe project coordinates. Prefer the modern publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback (optional): NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server ONLY. Modern sb_secret key or legacy service_role JWT.
SUPABASE_SECRET_KEY=
# Legacy fallback (optional): SUPABASE_SERVICE_ROLE_KEY=
# Fail closed: only this email can use the private app.
ALLOWED_USER_EMAIL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=
# 32 random bytes encoded as base64. Keep stable; changing it needs token re-encryption.
PLAID_TOKEN_ENCRYPTION_KEY=
